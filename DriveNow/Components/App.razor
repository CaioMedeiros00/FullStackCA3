<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/font/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <ImportMap />
    @* Apply the saved theme before Blazor starts, to avoid a light/dark flash. *@
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('drivenow-theme');
                if (theme) { document.documentElement.setAttribute('data-bs-theme', theme); }
            } catch (e) { }
        })();
    </script>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
    </div>
    <script src="@Assets["js/app.js"]"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // Interactive Server for the whole app. Prerendering is disabled because the
    // authentication state is read from browser session storage, which is only
    // available once the interactive circuit is connected.
    private static readonly IComponentRenderMode PageRenderMode = new InteractiveServerRenderMode(prerender: false);
}
