@* Reusable create-booking form with live conflict detection and cost calculator. *@
<EditForm Model="Model" OnValidSubmit="HandleValidSubmitAsync" FormName="booking-form">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrWhiteSpace(ServerError))
    {
        <AppAlert Type="AlertType.Danger" Title="Booking could not be created" Message="@ServerError" />
    }

    <div class="row g-3">
        <div class="col-12">
            <label for="customerName" class="form-label">Customer Name <span class="text-danger">*</span></label>
            <InputText id="customerName" class="form-control" @bind-Value="Model.CustomerName" placeholder="Full name" maxlength="100" />
            <ValidationMessage For="() => Model.CustomerName" />
        </div>

        <div class="col-12">
            <label for="car" class="form-label">Car <span class="text-danger">*</span></label>
            <InputSelect id="car" class="form-select" @bind-Value="Model.CarId">
                <option value="0">-- Select a car --</option>
                @foreach (var car in Cars.OrderBy(c => c.Make).ThenBy(c => c.Model))
                {
                    var outOfService = IsOutOfService(car);
                    <option value="@car.Id" disabled="@outOfService">
                        @car.Make @car.Model · @car.RegistrationNumber · @($"€{car.DailyRate:0.##}/day") @CarNote(car)
                    </option>
                }
            </InputSelect>
            <ValidationMessage For="() => Model.CarId" />
            <div class="form-text">Cars marked "out of service" have been made unavailable by staff and cannot be booked.</div>
        </div>

        <div class="col-12">
            <label for="location" class="form-label">Pickup Location <span class="text-danger">*</span></label>
            <InputSelect id="location" class="form-select" @bind-Value="Model.LocationId">
                <option value="0">-- Select a pickup location --</option>
                @foreach (var location in Locations.OrderBy(l => l.Name))
                {
                    <option value="@location.Id">@LocationLabel(location)</option>
                }
            </InputSelect>
            <ValidationMessage For="() => Model.LocationId" />
            @if (Locations.Count == 0)
            {
                <div class="form-text text-danger">Locations could not be loaded, so a booking cannot be created right now.</div>
            }
        </div>

        <div class="col-sm-6">
            <label for="startDate" class="form-label">Start Date <span class="text-danger">*</span></label>
            <InputDate id="startDate" class="form-control" @bind-Value="Model.StartDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <ValidationMessage For="() => Model.StartDate" />
        </div>
        <div class="col-sm-6">
            <label for="endDate" class="form-label">End Date <span class="text-danger">*</span></label>
            <InputDate id="endDate" class="form-control" @bind-Value="Model.EndDate" min="@Model.StartDate.AddDays(1).ToString("yyyy-MM-dd")" />
            <ValidationMessage For="() => Model.EndDate" />
        </div>
    </div>

    @if (SelectedCar is not null)
    {
        var carBookings = UpcomingBookingsForSelectedCar;
        <div class="mt-3">
            @if (Conflict is not null)
            {
                <AppAlert Type="AlertType.Warning" Title="Date conflict">
                    This car is already booked from <strong>@Conflict.StartDate.ToString("dd MMM yyyy")</strong>
                    to <strong>@Conflict.EndDate.ToString("dd MMM yyyy")</strong>. Please choose different dates or another car.
                </AppAlert>
            }
            else if (carBookings.Count > 0)
            {
                <div class="small text-body-secondary mb-2">
                    <i class="bi bi-calendar-x me-1"></i>Already booked:
                    @(string.Join(", ", carBookings.Select(b => $"{b.StartDate:dd MMM} – {b.EndDate:dd MMM}")))
                </div>
            }

            @if (Model.EndDate > Model.StartDate)
            {
                <div class="cost-summary rounded-3 p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-body-secondary">Estimated cost</div>
                        <div class="small">@BookingRules.RentalDays(Model) day(s) × @($"€{SelectedCar.DailyRate:0.00}")</div>
                    </div>
                    <div class="fs-4 fw-bold">@($"€{BookingRules.EstimatedCost(Model, SelectedCar):N2}")</div>
                </div>
            }
        </div>
    }

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button" class="btn btn-outline-secondary" disabled="@IsSaving" @onclick="OnCancel">Cancel</button>
        <button type="submit" class="btn btn-primary" disabled="@(IsSaving || Conflict is not null)">
            @if (IsSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                <span>Booking...</span>
            }
            else
            {
                <i class="bi bi-calendar-plus me-1"></i>
                <span>Create Booking</span>
            }
        </button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public Booking Model { get; set; } = new();
    [Parameter] public IReadOnlyList<Car> Cars { get; set; } = [];
    [Parameter] public IReadOnlyList<Booking> ExistingBookings { get; set; } = [];
    [Parameter] public IReadOnlyList<Location> Locations { get; set; } = [];
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public string? ServerError { get; set; }
    [Parameter] public EventCallback<Booking> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private static string LocationLabel(Location location) =>
        string.IsNullOrWhiteSpace(location.DisplayAddress) ? location.Name : $"{location.Name} · {location.DisplayAddress}";

    private Car? SelectedCar => Cars.FirstOrDefault(c => c.Id == Model.CarId);

    private Booking? Conflict => Model.CarId == 0 || Model.EndDate <= Model.StartDate
        ? null
        : ExistingBookings.FirstOrDefault(b => b.CarId == Model.CarId && BookingRules.Overlaps(b, Model));

    private List<Booking> UpcomingBookingsForSelectedCar => ExistingBookings
        .Where(b => b.CarId == Model.CarId && BookingRules.IsCurrentOrUpcoming(b, DateTime.Now))
        .OrderBy(b => b.StartDate)
        .ToList();

    private bool HasActiveBooking(Car car) =>
        ExistingBookings.Any(b => b.CarId == car.Id && BookingRules.IsActive(b, DateTime.Now));

    /// <summary>Unavailable but NOT because of a booking = taken out of service by staff.</summary>
    private bool IsOutOfService(Car car) => !car.Available && !HasActiveBooking(car);

    private string CarNote(Car car)
    {
        if (IsOutOfService(car))
        {
            return "(out of service)";
        }
        var active = ExistingBookings.FirstOrDefault(b => b.CarId == car.Id && BookingRules.IsActive(b, DateTime.Now));
        return active is null ? string.Empty : $"(booked until {active.EndDate:dd MMM})";
    }

    private async Task HandleValidSubmitAsync()
    {
        if (Conflict is not null)
        {
            return;
        }
        await OnValidSubmit.InvokeAsync(Model);
    }
}
