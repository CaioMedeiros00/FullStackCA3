@* Reusable "nothing to show" display. *@
<div class="empty-state text-center py-5 px-3">
    <div class="empty-state-icon mb-3"><i class="bi @Icon"></i></div>
    <h5 class="mb-1">@Title</h5>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="text-body-secondary mb-3">@Message</p>
    }
    @ChildContent
</div>

@code {
    [Parameter] public string Title { get; set; } = "Nothing here yet";
    [Parameter] public string? Message { get; set; }
    [Parameter] public string Icon { get; set; } = "bi-inbox";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
