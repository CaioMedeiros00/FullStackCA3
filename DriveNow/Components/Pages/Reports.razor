@page "/reports"
@inject CarService CarService
@inject BookingService BookingService

<PageTitle>Reports | DriveNow</PageTitle>

@* Role-based page: only Admin users can view reports. *@
<AuthorizeView Roles="@AuthService.AdminRole">
    <Authorized>
        <PageHeader Title="Reports" Icon="bi-bar-chart-line" Subtitle="Revenue and utilisation overview (administrators only)">
            <button class="btn btn-outline-secondary" @onclick="PrintAsync"><i class="bi bi-printer me-1"></i>Print / Save as PDF</button>
        </PageHeader>

        @if (isLoading)
        {
            <LoadingSpinner Message="Building report..." />
        }
        else if (error is not null)
        {
            <EmptyState Icon="bi-cloud-slash" Title="Report could not be generated" Message="@error">
                <button class="btn btn-primary" @onclick="LoadAsync"><i class="bi bi-arrow-repeat me-1"></i>Try again</button>
            </EmptyState>
        }
        else
        {
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <DashboardCard Title="Total Bookings" Value="@(bookings.Count.ToString())" Icon="bi-journal-check" Color="primary" />
                </div>
                <div class="col-sm-6 col-xl-3">
                    <DashboardCard Title="Estimated Revenue" Value="@(TotalRevenue.ToString("C0", Euro))" Icon="bi-currency-euro" Color="success"
                                   Subtitle="All bookings" />
                </div>
                <div class="col-sm-6 col-xl-3">
                    <DashboardCard Title="Avg. Rental" Value="@($"{AverageDays:0.0} days")" Icon="bi-hourglass-split" Color="info" />
                </div>
                <div class="col-sm-6 col-xl-3">
                    <DashboardCard Title="Avg. Daily Rate" Value="@(AverageRate.ToString("C0", Euro))" Icon="bi-tag" Color="warning"
                                   Subtitle="Across the fleet" />
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent"><h2 class="h6 mb-0">Revenue by car</h2></div>
                @if (rows.Count == 0)
                {
                    <EmptyState Icon="bi-car-front" Title="No data" Message="There are no cars to report on." />
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Car</th>
                                    <th class="text-end">Bookings</th>
                                    <th class="text-end">Days booked</th>
                                    <th class="text-end">Est. revenue</th>
                                    <th style="width: 30%">Share</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in rows)
                                {
                                    var share = TotalRevenue == 0 ? 0 : (double)(row.Revenue / TotalRevenue * 100);
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@row.Car.Make @row.Car.Model</div>
                                            <div class="small text-body-secondary font-monospace">@row.Car.RegistrationNumber</div>
                                        </td>
                                        <td class="text-end">@row.Bookings</td>
                                        <td class="text-end">@row.Days</td>
                                        <td class="text-end">@row.Revenue.ToString("C", Euro)</td>
                                        <td>
                                            <div class="progress" role="progressbar" aria-label="Revenue share" aria-valuenow="@share.ToString("0")" aria-valuemin="0" aria-valuemax="100">
                                                <div class="progress-bar bg-success" style="width: @share.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <EmptyState Icon="bi-shield-lock" Title="Access denied" Message="Only administrators can view reports.">
            <a href="" class="btn btn-primary">Back to dashboard</a>
        </EmptyState>
    </NotAuthorized>
</AuthorizeView>

@code {
    private sealed record CarReportRow(Car Car, int Bookings, int Days, decimal Revenue);

    private static readonly System.Globalization.CultureInfo Euro = new("en-IE");

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<Car> cars = [];
    private List<Booking> bookings = [];
    private List<CarReportRow> rows = [];
    private bool isLoading = true;
    private string? error;

    private decimal TotalRevenue => rows.Sum(r => r.Revenue);
    private double AverageDays => bookings.Count == 0 ? 0 : bookings.Average(b => BookingRules.RentalDays(b));
    private decimal AverageRate => cars.Count == 0 ? 0 : cars.Average(c => c.DailyRate);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;

        var carsTask = CarService.GetCarsAsync();
        var bookingsTask = BookingService.GetBookingsAsync();
        await Task.WhenAll(carsTask, bookingsTask);

        var carsResult = await carsTask;
        var bookingsResult = await bookingsTask;

        if (!carsResult.Success || !bookingsResult.Success)
        {
            error = carsResult.ErrorMessage ?? bookingsResult.ErrorMessage;
        }
        else
        {
            cars = carsResult.Data ?? [];
            bookings = bookingsResult.Data ?? [];
            rows = cars
                .Select(car =>
                {
                    var carBookings = bookings.Where(b => b.CarId == car.Id).ToList();
                    return new CarReportRow(car, carBookings.Count,
                        carBookings.Sum(b => BookingRules.RentalDays(b)),
                        carBookings.Sum(b => BookingRules.EstimatedCost(b, car)));
                })
                .OrderByDescending(r => r.Revenue)
                .ToList();
        }

        isLoading = false;
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");
}
